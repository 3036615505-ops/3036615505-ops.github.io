      "ES2019",
      "DOM"
    ],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "types": []
  },
  "include": [
    "js/types.d.ts",
    "js/reader.dom.js",
    "js/reader.flags.js",
    "js/reader.store.js",
    "js/reader.engine.js",
    "js/reader.ui.js",
    "js/reader.js",
    "js/chapters.js",
    "js/announce.js",
    "js/nav-feedback.js",
    "js/native-bridge.js",
    "js/theme.js",
    "js/transition.js",
    "js/lightbox.js",
    "js/characters-data.js"
  ]
}
